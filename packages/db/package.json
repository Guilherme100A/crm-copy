{
  "name": "@crm/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "development": "./src/testing.ts",
      "default": "./dist/testing.js"
    },
    "./wa": {
      "types": "./src/schema/wa/tables/index.ts",
      "development": "./src/schema/wa/tables/index.ts",
      "default": "./dist/schema/wa/tables/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/testing.ts src/schema/wa/tables/index.ts --format esm --target node22 --platform node --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "migrate": "tsx src/migrate.ts",
    "db:generate:wa": "drizzle-kit generate --config drizzle.wa.config.ts",
    "db:generate:crm": "drizzle-kit generate --config drizzle.crm.config.ts"
  },
  "dependencies": {
    "@crm/node-kit": "workspace:^",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
