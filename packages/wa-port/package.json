{
  "name": "@crm/wa-port",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "development": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    },
    "./contract": {
      "types": "./src/contract/index.ts",
      "development": "./src/contract/index.ts",
      "default": "./dist/contract/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/testing/index.ts src/contract/index.ts --format esm --target node22 --platform neutral --external vitest --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "vitest": "5.0.1",
    "zod": "4.6.5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
