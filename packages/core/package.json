{
  "name": "@crm/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./meta-testing": {
      "types": "./src/meta-ads/client/testing/index.ts",
      "development": "./src/meta-ads/client/testing/index.ts",
      "default": "./dist/meta-ads/client/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/meta-ads/client/testing/index.ts --format esm --target node22 --platform node --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@crm/ai": "workspace:^",
    "@crm/db": "workspace:^",
    "@crm/node-kit": "workspace:^",
    "@crm/shared": "workspace:^",
    "@crm/wa-port": "workspace:*",
    "bullmq": "6.3.8",
    "drizzle-orm": "0.45.3",
    "ioredis": "6.0.0",
    "papaparse": "5.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/papaparse": "5.5.2"
  }
}
