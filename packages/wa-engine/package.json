{
  "name": "@crm/wa-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./transport": {
      "types": "./src/transport/index.ts",
      "development": "./src/transport/index.ts",
      "default": "./dist/transport/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/transport/index.ts --format esm --target node22 --platform node --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@crm/db": "workspace:*",
    "@crm/node-kit": "workspace:*",
    "@crm/wa-port": "workspace:*",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "baileys-antiban": "4.10.0",
    "drizzle-orm": "0.45.3",
    "https-proxy-agent": "9.1.0",
    "sharp": "0.35.4",
    "socks-proxy-agent": "10.1.0"
  }
}
