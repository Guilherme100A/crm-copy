{
  "name": "@crm/wa-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./antiban": {
      "types": "./src/antiban/index.ts",
      "development": "./src/antiban/index.ts",
      "default": "./dist/antiban/index.js"
    },
    "./proxy": {
      "types": "./src/proxy/index.ts",
      "development": "./src/proxy/index.ts",
      "default": "./dist/proxy/index.js"
    },
    "./queue": {
      "types": "./src/queue/index.ts",
      "development": "./src/queue/index.ts",
      "default": "./dist/queue/index.js"
    },
    "./safety": {
      "types": "./src/safety/index.ts",
      "development": "./src/safety/index.ts",
      "default": "./dist/safety/index.js"
    },
    "./session": {
      "types": "./src/session/index.ts",
      "development": "./src/session/index.ts",
      "default": "./dist/session/index.js"
    },
    "./transport": {
      "types": "./src/transport/index.ts",
      "development": "./src/transport/index.ts",
      "default": "./dist/transport/index.js"
    },
    "./warmup": {
      "types": "./src/warmup/index.ts",
      "development": "./src/warmup/index.ts",
      "default": "./dist/warmup/index.js"
    },
    "./send": {
      "types": "./src/send/index.ts",
      "development": "./src/send/index.ts",
      "default": "./dist/send/index.js"
    },
    "./health": {
      "types": "./src/health/index.ts",
      "development": "./src/health/index.ts",
      "default": "./dist/health/index.js"
    },
    "./events": {
      "types": "./src/events/index.ts",
      "development": "./src/events/index.ts",
      "default": "./dist/events/index.js"
    },
    "./media": {
      "types": "./src/media/index.ts",
      "development": "./src/media/index.ts",
      "default": "./dist/media/index.js"
    },
    "./contacts": {
      "types": "./src/contacts/index.ts",
      "development": "./src/contacts/index.ts",
      "default": "./dist/contacts/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/transport/index.ts src/queue/index.ts src/antiban/index.ts src/warmup/index.ts src/safety/index.ts src/session/index.ts src/proxy/index.ts src/send/index.ts src/health/index.ts src/events/index.ts src/media/index.ts src/contacts/index.ts --format esm --target node22 --platform node --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@crm/db": "workspace:*",
    "@crm/node-kit": "workspace:*",
    "@crm/wa-port": "workspace:*",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "baileys-antiban": "4.10.0",
    "bullmq": "6.3.8",
    "drizzle-orm": "0.45.3",
    "https-proxy-agent": "9.1.0",
    "ioredis": "6.0.0",
    "qrcode": "1.5.4",
    "sharp": "0.35.4",
    "socks-proxy-agent": "10.1.0"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6"
  }
}
