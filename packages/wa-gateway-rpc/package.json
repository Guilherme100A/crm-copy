{
  "name": "@crm/wa-gateway-rpc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "development": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/testing/index.ts --format esm --target node22 --platform node --external vitest --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@crm/node-kit": "workspace:*",
    "@crm/wa-port": "workspace:*",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@crm/db": "workspace:*",
    "@crm/wa-worker": "workspace:*"
  }
}
