{
  "name": "@crm/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./flows": {
      "types": "./src/flows/index.ts",
      "development": "./src/flows/index.ts",
      "default": "./dist/flows/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/flows/index.ts --format esm --target node22 --platform neutral --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "libphonenumber-js": "1.13.15",
    "zod": "4.6.5"
  }
}
