# Variáveis de ambiente (SPEC 3.12). Copie para .env e ajuste. Nenhum valor aqui é segredo real.

# --- App ---
APP_NAME=CRM
NODE_ENV=development
LOG_LEVEL=info
API_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:5173

# --- Persistência ---
DATABASE_URL=postgres://wsm:wsm@127.0.0.1:5432/crm
REDIS_URL=redis://127.0.0.1:6379/1
STORAGE_DIR=./storage

# --- Segurança ---
# 32 bytes em base64 (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
CREDENTIALS_KEY=
AUTH_SESSION_TTL_DAYS=30
INTERNAL_TOKEN=

# --- E-mail ---
MAIL_TRANSPORT=memory
SMTP_URL=
MAIL_FROM=no-reply@example.com

# --- WhatsApp ---
WA_GATEWAY=fake
WA_RPC_URL=http://127.0.0.1:3100
# Modo extensão sobre o worker do ai-manager (T98): WA_GATEWAY=rpc + WA_RPC_PROFILE=ai-manager; ver docs/extension/ai-manager.md
WA_RPC_PROFILE=crm
# Timeout de cada chamada ao RPC do wa-worker em ms (T46; o pareamento usa 60 s). Vazio = 30000
WA_RPC_TIMEOUT_MS=
# Só o wa-worker
WA_TRANSPORT=fake
ANTIBAN_MODE=real
ANTIBAN_PRESET=
WA_EVENTS_STREAM=wsm:events
# RPC interno do wa-worker (T29): porta/host onde escuta (WA_RPC_URL aponta para cá; 0 = porta aleatória)
WA_RPC_PORT=3100
# Padrão só loopback: o RPC controla sessões e envios. Em contêiner, defina o host explicitamente (ex.: 0.0.0.0
# numa rede interna, nunca publicada).
WA_RPC_HOST=127.0.0.1
# Prefixo do BullMQ (`<prefix>:session:<id>`) e das chaves Redis do wa-worker; igual ao do ai-manager
WA_QUEUE_PREFIX=wsm
# Prefixo das filas/workers BullMQ do CRM (flow-step, imports, ai-agent…), lido na criação de cada fila (T121).
# Produção: crm. Os testes definem um prefixo único por execução (vitest test.env) para não disputar jobs entre worktrees.
CRM_QUEUE_PREFIX=crm

# --- IA ---
AI_MODE=fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# URLs base dos provedores (T38: teste da chave, modelos OpenRouter, vozes ElevenLabs); vazio = API oficial.
# Nos testes apontam para servidores fake.
ANTHROPIC_API_URL=
OPENAI_API_URL=
GOOGLE_API_URL=
OPENROUTER_API_URL=
ELEVENLABS_API_URL=
GROQ_API_URL=
FFMPEG_PATH=

# --- Meta ---
META_GRAPH_URL=https://graph.facebook.com/v26.0
# T99: callback do Facebook Login registrado no app (vazio = <API_PUBLIC_URL>/api/meta/oauth/callback) e base do diálogo
META_OAUTH_REDIRECT_URI=
META_OAUTH_DIALOG_URL=https://www.facebook.com
META_APP_ID=
META_APP_SECRET=
# T104/T125: código de teste da Conversions API (Events Manager → Testar eventos). Opcional; ignorado com NODE_ENV=production
META_CAPI_TEST_EVENT_CODE=

# --- Emissão de NF (T112) ---
# Base da API da Notasy (o token é por empresa, cifrado no banco). Nos testes, aponte para o FakeNotasy.
NOTASY_API_URL=https://api-notasy.com.br

# --- UTMify (T113) ---
# Base da API da UTMify (a credencial de API é por empresa, cifrada no banco). Nos testes, aponte para o FakeUtmify.
UTMIFY_API_URL=https://api.utmify.com.br

# --- Plataforma ---
AFFILIATE_PORTAL_URL=
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=

# --- Testes (só o harness E2E) ---
E2E=
