{
  "name": "@crm/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node22 --platform node --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@crm/ai": "workspace:*",
    "@crm/core": "workspace:*",
    "@crm/db": "workspace:*",
    "@crm/node-kit": "workspace:*",
    "@crm/wa-gateway-rpc": "workspace:*",
    "@crm/wa-port": "workspace:*",
    "bullmq": "6.3.8",
    "drizzle-orm": "0.45.3",
    "ioredis": "6.0.0",
    "zod": "4.6.5"
  }
}
