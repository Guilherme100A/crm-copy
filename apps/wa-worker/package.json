{
  "name": "@crm/wa-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node22 --platform node --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@crm/db": "workspace:*",
    "@crm/node-kit": "workspace:*",
    "@crm/wa-engine": "workspace:*",
    "@crm/wa-port": "workspace:*",
    "@hono/node-server": "2.1.1",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.8",
    "ioredis": "6.0.0"
  }
}
